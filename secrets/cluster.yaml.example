# Cluster secrets are split (nodes flake cannot import this directory):
#
#   nodes/secrets/cluster.yaml     — k3s token (sops-nix on RK1s)
#   k8s/clusters/homelab/infra/core/grafana-admin.secret.yaml
#                                  — Grafana admin (Flux sops decryption)
#
# Do not put the k3s token here; janus would become a recipient via
# secrets/.sops.yaml.
