# Copy to router.yaml and encrypt with sops once age keys exist.
#
# Bootstrap (janus):
#   mkdir -p /var/lib/sops-nix
#   age-keygen -o /var/lib/sops-nix/key.txt
# Add the janus public key AND a workstation identity to secrets/.sops.yaml.
# Backup /var/lib/sops-nix/key.txt offline. Host sops.* is in
# router/hosts/optiplex/configuration.nix; Caddy env template is in caddy.nix.
# sops --encrypt --in-place secrets/router.yaml
wireguard:
  serverPrivateKey: REPLACE
dnsupdater:
  domeneshopToken: REPLACE
  domeneshopSecret: REPLACE
# Caddy ACME DNS-01 (same Domeneshop API user as DNSUpdater is fine).
# Expose to the caddy unit as DOMAINNAMESHOP_API_TOKEN / _SECRET
# via sops.templates."caddy-domeneshop.env" in caddy.nix.
caddy:
  domeneshopToken: REPLACE
  domeneshopSecret: REPLACE
