# Edge proxy on janus (NixOS). Caddyfile is the source of truth;
# router/modules/caddy.nix loads it. Backends are on TrueNAS / Traefik.
#
# Stage 5: *.lab.zdk.no only. Uncomment public sites at Stage 7
# (enableWanCaddy). ACME is DNS-01 via Domeneshop (decision-briefs #3):
# no public A records for lab names; HTTP-01 is not the v1 path.
# Live `acme_dns` stays in caddy.nix until the Caddy binary includes
# github.com/caddy-dns/domainnameshop (`withPlugins` on nixos-unstable).
# Until then, lab vhosts use Caddy's internal CA (`tls internal`).

(lab_tls) {
	tls internal
}

(authelia) {
	forward_auth 10.10.30.20:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

# Authelia portal — no forward_auth (would loop)
auth.lab.zdk.no {
	import lab_tls
	reverse_proxy 10.10.30.20:9091
	encode gzip
}

ha.lab.zdk.no {
	import lab_tls
	reverse_proxy 10.10.30.20:8123
	encode gzip
}

# Forgejo internal until Stage 7 — Forgejo-native auth, no Authelia
code.lab.zdk.no {
	import lab_tls
	reverse_proxy 10.10.30.20:3000
	encode gzip
}

# Stage 6 — Headscale on 127.0.0.1:8081 (UniFi Inform owns :8080).
# No Authelia — Tailscale clients use this as login-server.
# headscale.lab.zdk.no {
# 	reverse_proxy 127.0.0.1:8081
# 	encode gzip
# }

# TrueNAS UI — native auth, no Authelia. Caddy reaches the host on VLAN 30
# (OUTPUT); trusted/mgmt browse via truenas.lab.zdk.no, not the raw IP.
truenas.lab.zdk.no {
	import lab_tls
	reverse_proxy https://10.10.30.20:443 {
		transport http {
			tls_insecure_skip_verify
		}
		header_up Host 10.10.30.20
		header_down Location https://10.10.30.20 https://truenas.lab.zdk.no
	}
	encode gzip
}

# UniFi UI is :11443 on janus. unifi.lab.zdk.no → Caddy (.30.1) in Unbound.
# Until this vhost exists, browse https://10.10.10.1:11443 (trusted/mgmt).
# Inform stays http://10.10.10.1:8080 — do not proxy Inform.
unifi.lab.zdk.no {
	import lab_tls
	reverse_proxy https://127.0.0.1:11443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
	encode gzip
}

# k8s UIs — 502 until Traefik is up (Stage 5 k8s)
grafana.lab.zdk.no {
	import lab_tls
	import authelia
	reverse_proxy 10.10.30.100:80
	encode gzip
}

capacitor.lab.zdk.no {
	import lab_tls
	import authelia
	reverse_proxy 10.10.30.100:80
	encode gzip
}

