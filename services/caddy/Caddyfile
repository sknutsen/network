# Edge proxy on janus (NixOS). Caddyfile is the source of truth;
# router/modules/caddy.nix loads it. Backends are on TrueNAS / Traefik.
#
# Lab names (*.lab.zdk.no): never public A/AAAA. ACME is DNS-01 via
# Domeneshop (dns01 snippet). resolvers must be public — Unbound on janus
# is split-horizon and cannot answer NS for zdk.no. lab_only refuses WAN
# clients even if they guess the Host header.
#
# Public names (img.zdk.no, ha.zdk.no, code.zdk.no): same DNS-01 issuer.
# Apex zdk.no is not a homelab site.

# Admin lab vhosts. Guest and IoT can TCP to :443 (Jellyfin / HA), so this
# is no longer 10.10.0.0/16 — a guessed Host header must not reach
# TrueNAS / Grafana / UniFi. WAN clients still abort.
(lab_only) {
	@not_lan not remote_ip 10.10.20.0/24 10.10.30.0/24 10.10.255.0/24 127.0.0.1
	abort @not_lan
}

# Household: trusted + servers + VPN + guest + Samsung TV. Not the rest
# of IoT, not mgmt, not WAN. Pair with INPUT from guest and IoT.
(household) {
	@not_household not remote_ip 10.10.20.0/24 10.10.30.0/24 10.10.255.0/24 10.10.50.0/24 10.10.40.10 127.0.0.1
	abort @not_household
}

# HA lab name: trusted + servers + VPN + IoT (companion / Matter phone).
# Not guest, not WAN — those use ha.zdk.no.
(ha_lan) {
	@not_ha not remote_ip 10.10.20.0/24 10.10.30.0/24 10.10.255.0/24 10.10.40.0/24 127.0.0.1
	abort @not_ha
}

# Public apps that must stay off guest/IoT LAN INPUT (WAN still allowed).
(not_untrusted) {
	@untrusted remote_ip 10.10.40.0/24 10.10.50.0/24
	abort @untrusted
}

# Public resolvers + delay: Domeneshop TXT can take ~60s; local Unbound
# must not be used for propagation or NS lookup.
(dns01) {
	tls {
		dns domainnameshop {env.DOMAINNAMESHOP_API_TOKEN} {env.DOMAINNAMESHOP_API_SECRET}
		resolvers 1.1.1.1 9.9.9.9
		propagation_delay 60s
	}
}

# Samsung Tizen / Jellyfin TV: Let's Encrypt ECDSA (YE2 → Root YE) is not
# in the TV trust store. RSA intermediates still chain to ISRG Root X1.
(dns01_rsa) {
	tls {
		dns domainnameshop {env.DOMAINNAMESHOP_API_TOKEN} {env.DOMAINNAMESHOP_API_SECRET}
		resolvers 1.1.1.1 9.9.9.9
		propagation_delay 60s
		key_type rsa2048
	}
}

(authelia) {
	forward_auth 10.10.30.20:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

# TrueNAS App publishes HTTPS on the host port (HTTP gets EOF → Caddy 502).
(ha_proxy) {
	reverse_proxy https://10.10.30.20:30103 {
		transport http {
			tls_insecure_skip_verify
		}
	}
	encode gzip
}

# Jellyfin: long-lived video, range requests, websockets. No Authelia —
# TV / mobile clients use native login. HTTP on the TrueNAS App port.
(jellyfin_proxy) {
	reverse_proxy 10.10.30.20:30013 {
		header_up X-Real-IP {remote_host}
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# Immich: large uploads, long-lived photo/video transfers, websockets.
# No Authelia — mobile app and API would break. Native Immich login.
(immich_proxy) {
	reverse_proxy 10.10.30.20:30041 {
		header_up X-Real-IP {remote_host}
		flush_interval -1
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}

# Authelia portal — no forward_auth (would loop)
auth.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy 10.10.30.20:9091
	encode gzip
}

ha.lab.zdk.no {
	import ha_lan
	import dns01
	import ha_proxy
}

# Public HA — same backend, HA-native auth (companion app).
ha.zdk.no {
	import dns01
	import ha_proxy
}

immich.lab.zdk.no {
	import lab_only
	import dns01
	import immich_proxy
}

# Household — not WAN. Same URL for trusted, guest, and the TV.
jellyfin.lab.zdk.no {
	import household
	import dns01_rsa
	import jellyfin_proxy
}

# Public Immich — same backend. LAN uses split-horizon → Caddy.
img.zdk.no {
	import not_untrusted
	import dns01
	import immich_proxy
}

# Forgejo internal — HTTP on :30142 (not TLS). No Authelia.
code.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy 10.10.30.20:30142
	encode gzip
}

# Headscale on 127.0.0.1:8081 (UniFi Inform owns :8080).
# No Authelia — Tailscale clients use this as login-server.
headscale.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy 127.0.0.1:8081
	encode gzip
}

# TrueNAS UI — native auth, no Authelia. Caddy reaches the host on VLAN 30
# (OUTPUT); trusted/mgmt browse via truenas.lab.zdk.no, not the raw IP.
truenas.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy https://10.10.30.20:443 {
		transport http {
			tls_insecure_skip_verify
		}
		header_up Host 10.10.30.20
		header_down Location https://10.10.30.20 https://truenas.lab.zdk.no
	}
	encode gzip
}

# UniFi UI is :11443 on janus. unifi.lab.zdk.no → Caddy (.30.1) in Unbound.
# Inform stays http://10.10.10.1:8080 — do not proxy Inform.
# Caddy 2.11+ HTTPS-to-IP defaults Host to 127.0.0.1:11443; UniFi OS then
# accepts GET / but rejects /api/ws/* upgrades (blank UI after login).
# HTTP/1.1 + empty Origin are required for those sockets. No gzip.
unifi.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy https://127.0.0.1:11443 {
		transport http {
			tls_insecure_skip_verify
			versions 1.1
		}
		flush_interval -1
		header_up Host {hostport}
		header_up Origin ""
		header_up -Referer
	}
}

# k8s UIs via Traefik MetalLB .100
grafana.lab.zdk.no {
	import lab_only
	import dns01
	import authelia
	reverse_proxy 10.10.30.100:80
	encode gzip
}

capacitor.lab.zdk.no {
	import lab_only
	import dns01
	import authelia
	reverse_proxy 10.10.30.100:80
	encode gzip
}

alertmanager.lab.zdk.no {
	import lab_only
	import dns01
	import authelia
	reverse_proxy 10.10.30.100:80
	encode gzip
}

code.zdk.no {
	import not_untrusted
	import dns01
	reverse_proxy 10.10.30.20:30142
	encode gzip
}
