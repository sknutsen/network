# Edge proxy on janus (NixOS). Caddyfile is the source of truth;
# router/modules/caddy.nix loads it. Backends are on TrueNAS / Traefik.
#
# Lab names (*.lab.zdk.no): never public A/AAAA. ACME is DNS-01 via
# Domeneshop (dns01 snippet). resolvers must be public — Unbound on janus
# is split-horizon and cannot answer NS for zdk.no. lab_only refuses WAN
# clients even if they guess the Host header.
#
# Public names (img.zdk.no, ha.zdk.no): same DNS-01 issuer (WAN 80 is
# closed until enableWanCaddy). zdk.no / code.zdk.no stay commented until
# those apps are ready.

# Trusted, servers, VPN (10.10.255.0/24 ⊂ 10.10.0.0/16). Guest/IoT never
# reach Caddy INPUT; this is for WAN clients hitting a lab Host header.
(lab_only) {
	@not_lan not remote_ip 10.10.0.0/16 127.0.0.1
	abort @not_lan
}

# Public resolvers + delay: Domeneshop TXT can take ~60s; local Unbound
# must not be used for propagation or NS lookup.
(dns01) {
	tls {
		dns domainnameshop {env.DOMAINNAMESHOP_API_TOKEN} {env.DOMAINNAMESHOP_API_SECRET}
		resolvers 1.1.1.1 9.9.9.9
		propagation_delay 60s
	}
}

(authelia) {
	forward_auth 10.10.30.20:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

(ha_proxy) {
	reverse_proxy 10.10.30.20:30103
	encode gzip
}

# Immich: large uploads, long-lived photo/video transfers, websockets.
# No Authelia — mobile app and API would break. Native Immich login.
(immich_proxy) {
	reverse_proxy 10.10.30.20:30041 {
		header_up X-Real-IP {remote_host}
		flush_interval -1
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}

# Authelia portal — no forward_auth (would loop)
auth.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy 10.10.30.20:9091
	encode gzip
}

ha.lab.zdk.no {
	import lab_only
	import dns01
	import ha_proxy
}

# Public HA — same backend, HA-native auth (companion app).
ha.zdk.no {
	import dns01
	import ha_proxy
}

immich.lab.zdk.no {
	import lab_only
	import dns01
	import immich_proxy
}

# Public Immich — same backend. LAN uses split-horizon → Caddy.
img.zdk.no {
	import dns01
	import immich_proxy
}

# Forgejo internal until Stage 7 — Forgejo-native auth, no Authelia
code.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy 10.10.30.20:3000
	encode gzip
}

# Stage 6 — Headscale on 127.0.0.1:8081 (UniFi Inform owns :8080).
# No Authelia — Tailscale clients use this as login-server.
# headscale.lab.zdk.no {
