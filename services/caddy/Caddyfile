# TrueNAS UI — native auth, no Authelia. Caddy reaches the host on VLAN 30
# (OUTPUT); trusted/mgmt browse via truenas.lab.zdk.no, not the raw IP.
truenas.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy https://10.10.30.20:443 {
		transport http {
			tls_insecure_skip_verify
		}
		header_up Host 10.10.30.20
		header_down Location https://10.10.30.20 https://truenas.lab.zdk.no
	}
	encode gzip
}

# UniFi UI is :11443 on janus. unifi.lab.zdk.no → Caddy (.30.1) in Unbound.
# Until this vhost exists, browse https://10.10.10.1:11443 (trusted/mgmt).
# Inform stays http://10.10.10.1:8080 — do not proxy Inform.
unifi.lab.zdk.no {
	import lab_only
	import dns01
	reverse_proxy https://127.0.0.1:11443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
	encode gzip
}

# k8s UIs — 502 until Traefik is up (Stage 5 k8s)
grafana.lab.zdk.no {
	import lab_only
	import dns01
	import authelia
	reverse_proxy 10.10.30.100:80
	encode gzip
}

capacitor.lab.zdk.no {
	import lab_only
	import dns01
	import authelia
	reverse_proxy 10.10.30.100:80
	encode gzip
}

